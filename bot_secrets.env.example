# Copy to bot_secrets.env and fill in (bot_secrets.env is gitignored).
# Single file for all bot credentials — do not commit the real file.
#
# KITE_TOTP_SECRET = base32 secret from Zerodha 2FA setup (NOT the 6-digit code).
#   Google Authenticator → account → setup key / manual entry.
#
# Kite developer console redirect URL must include: http://127.0.0.1

# --- Zerodha Kite Connect ---
KITE_API_KEY='your-kite-api-key'
KITE_API_SECRET='your-kite-api-secret'
KITE_USER_ID='your-zerodha-client-id'
KITE_PASSWORD='your-zerodha-password'
KITE_TOTP_SECRET='your-base32-totp-secret'

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN='your-token-from-BotFather'
TELEGRAM_CHAT_ID='your-chat-id'

# --- Dashboard (optional — required for public URL) ---
# Random secret; add ?token=... to the dashboard link. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_DASHBOARD_TOKEN='your-random-dashboard-token'
